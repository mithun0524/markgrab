{
  "manifest_version": 3,
  "name": "MarkGrab",
  "version": "0.1.0",
  "description": "Copy any selection or page as clean, LLM-ready Markdown.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "clipboardWrite"],
  "background": { "service_worker": "src/background/background.ts", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "MarkGrab" },
  "commands": {
    "copy-markdown": {
      "suggested_key": { "default": "Ctrl+Shift+M", "mac": "Command+Shift+M" },
      "description": "Copy selection or page as Markdown"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
